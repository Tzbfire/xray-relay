# 管理页面端口
ADMIN_PORT=18080

# 代理端口映射范围
# 新增节点的 local_port 建议放在这个范围内
PORT_RANGE_START=11080
PORT_RANGE_END=11120

# 容器时区
TZ=Asia/Shanghai

# 构建时使用的上游镜像
# 默认锁定到当前已验证可用的版本，保证可复现
# 如果你想跟随上游更新，可以自行改成 :latest 或指定 tag
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.4.17@sha256:1880a26aee27e82d779b9632a88d5256403e8b33d9abffa1c7920f2fffb73bc3
SINGBOX_IMAGE=ghcr.io/sagernet/sing-box@sha256:9bed1fcb406bd971d1b48c7f824e5128d63543ca278cdcd6b5737c19941e404d

# 容器内二进制与配置路径
XRAY_BIN=/opt/relay-bin/xray
XRAY_CONFIG=/data/xray-config.json
SINGBOX_BIN=/opt/relay-bin/sing-box
SINGBOX_CONFIG=/data/singbox-config.json

# sing-box 运行模式
# single: 单进程承载多个节点
# per_node: 每个节点独立一个进程
SINGBOX_MODE=single
