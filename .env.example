# Web UI listen port inside container
ADMIN_PORT=18080

# Proxy port range exposed by docker-compose
# Keep your node local_port values inside this mapped range unless you expand it.
PORT_RANGE_START=11080
PORT_RANGE_END=11120

# Runtime timezone
TZ=Asia/Shanghai

# Upstream runtime images used in multi-stage build.
# Default is pinned to known-good digests for reproducibility.
# You may switch them to a tag such as :latest if you want to follow upstream releases.
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.4.17@sha256:1880a26aee27e82d779b9632a88d5256403e8b33d9abffa1c7920f2fffb73bc3
SINGBOX_IMAGE=ghcr.io/sagernet/sing-box@sha256:9bed1fcb406bd971d1b48c7f824e5128d63543ca278cdcd6b5737c19941e404d

# Default runtime binaries inside container
XRAY_BIN=/usr/local/bin/xray
XRAY_CONFIG=/data/xray-config.json
SINGBOX_BIN=/usr/local/bin/sing-box
SINGBOX_CONFIG=/data/singbox-config.json

# sing-box runtime mode:
# - single: one sing-box process with multiple outbounds
# - per_node: one sing-box process per node
SINGBOX_MODE=single
